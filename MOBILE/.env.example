# Base URL of studzee-api. When unset the app falls back to the deployed
# Render URL baked into utils/config.ts. Point this at a local API with your
# machine's LAN IP for device testing, or 10.0.2.2:4000 for an Android
# emulator.
EXPO_PUBLIC_BACKEND_API_URL=https://studzee-api-latest.onrender.com

# Required. Publishable key from the Clerk dashboard API keys page; the app
# throws at boot without it.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
