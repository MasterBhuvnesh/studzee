# =============================================================================
#  STUDZEE BACKEND - TEST ENVIRONMENT
# =============================================================================
#  Points every dependency at the local docker-compose stack, using separate
#  database names so a test run can never touch development data.
#
#      make up
#      npm test
#
#  src/tests/setup/globalSetup.ts also seeds safe defaults for every required
#  variable, so the suite still runs on a checkout with no env file at all.
#  This file exists for running tests against the real containers instead.
#
#  Every credential here is a throwaway local value.
# =============================================================================


# -----------------------------------------------------------------------------
#  SERVER
# -----------------------------------------------------------------------------

PORT=4000
NODE_ENV=development


# -----------------------------------------------------------------------------
#  AUTHENTICATION (CLERK)
# -----------------------------------------------------------------------------
#  Placeholders. Authenticate with DEV_TOKEN rather than a real Clerk session.

CLERK_SECRET_KEY=sk_test_1234567890
CLERK_PUBLISHABLE_KEY=pk_test_1234567890
CLERK_WEBHOOK_SIGNING_SECRET=whsec_1234567890
DEV_TOKEN=token


# -----------------------------------------------------------------------------
#  MONGODB  (content)
# -----------------------------------------------------------------------------

MONGO_PORT=27017
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=password
MONGO_URI=mongodb://root:password@localhost:27017/contentdb?authSource=admin
MONGO_EXPRESS_PORT=8081


# -----------------------------------------------------------------------------
#  POSTGRES  (users, push tokens, notification and email logs)
# -----------------------------------------------------------------------------
#  A separate database from development, so a test run cannot destroy real rows.

POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=studzee_notifications_test
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/studzee_notifications_test


# -----------------------------------------------------------------------------
#  REDIS  (read cache)
# -----------------------------------------------------------------------------
#  Database index 1, so tests do not evict the development cache in index 0.

REDIS_PORT=6379
REDIS_INSIGHT_PORT=8001
REDIS_URL=redis://localhost:6379/1
REDIS_INSIGHT_URL=http://localhost:8001


# -----------------------------------------------------------------------------
#  CACHING AND JOBS
# -----------------------------------------------------------------------------

LIST_CACHE_TTL=300
DOC_CACHE_TTL=86400
TODAY_CACHE_TTL=3600


# -----------------------------------------------------------------------------
#  OBJECT STORAGE (MINIO STANDING IN FOR S3)
# -----------------------------------------------------------------------------

MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=miniopassword
MINIO_BUCKET_NAMES=images,pdfs
MINIO_REGION=us-east-1
MINIO_ENDPOINT=http://localhost:9000
MINIO_CONSOLE_ENDPOINT=http://localhost:9001

S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=miniopassword
S3_BUCKET_IMAGES=images
S3_BUCKET_PDFS=pdfs
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000


# -----------------------------------------------------------------------------
#  EMAIL (MAILPIT STANDING IN FOR AN SMTP PROVIDER)
# -----------------------------------------------------------------------------
#  Mailpit catches everything, so a test run can never send real email.

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=test
SMTP_PASSWORD=test
EMAIL_FROM=Studzee <no-reply@studzee.local>
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
EMAIL_ATTACHMENT_HOSTS=lammfakgegmrkxdkwukd.supabase.co,localhost


# -----------------------------------------------------------------------------
#  OBSERVABILITY
# -----------------------------------------------------------------------------

LOG_LEVEL=info
