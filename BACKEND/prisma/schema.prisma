// Postgres schema for the notification side of the backend.
// Content lives in MongoDB and is modelled with Mongoose under src/models.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A registered app user, mirrored from Clerk on first token registration.
/// One user can hold several Expo push tokens, one per device.
model User {
  id         String   @id @default(cuid())
  clerkId    String   @unique
  email      String   @unique
  expoTokens String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([clerkId])
  @@index([email])
}

/// Audit record of a push notification broadcast.
/// sentTo is empty when the broadcast targeted every registered user.
model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  imageUrl  String?
  sentBy    String
  sentTo    String[]
  sentToAll Boolean  @default(false)
  status    String   @default("sent")
  createdAt DateTime @default(now())

  @@index([sentBy])
  @@index([createdAt])
}

/// Audit record of an outbound transactional email.
model EmailLog {
  id        String   @id @default(cuid())
  subject   String
  message   String   @db.Text
  pdfUrls   String[]
  sentBy    String
  sentTo    String[]
  status    String   @default("sent")
  createdAt DateTime @default(now())

  @@index([sentBy])
  @@index([createdAt])
}

/// One graded quiz submission. userId holds the Clerk user id, matching the
/// rest of the tracker tables; contentId is the Mongo document id.
model QuizAttempt {
  id            String   @id @default(cuid())
  userId        String
  contentId     String
  score         Int
  total         Int
  pointsAwarded Int
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([contentId])
  @@index([userId, createdAt])
}

/// One row per UTC day on which a user recorded activity, so streaks derive
/// from history instead of being trusted from the client.
model DailyActivity {
  id     String   @id @default(cuid())
  userId String
  date   DateTime @db.Date

  @@unique([userId, date])
}

/// Badges already granted to a user. Badge definitions live in code, this
/// table only records that a threshold was reached and when it first happened.
model AwardedBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeKey  String
  awardedAt DateTime @default(now())

  @@unique([userId, badgeKey])
}

/// Aggregate per user counters for the tracker read side. Points are the sum
/// of pointsAwarded across attempts and are maintained in the same transaction
/// that records an attempt.
model UserProgress {
  id            String   @id @default(cuid())
  userId        String   @unique
  points        Int      @default(0)
  currentStreak Int      @default(0)
  longestStreak Int      @default(0)
  updatedAt     DateTime @updatedAt
}

/// A limited time challenge a user can complete once for gems. type is one of
/// mcq, scq, fill_blank or read_blog. payload holds the graded questions for
/// the graded types and is left out for read_blog. contentId is the Mongo
/// document id a read_blog quest asks the caller to open. active lets an
/// admin withdraw a quest before its window runs out.
model Quest {
  id          String   @id @default(cuid())
  title       String   @unique
  description String
  type        String
  gems        Int
  contentId   String?
  payload     Json?
  active      Boolean  @default(true)
  startsAt    DateTime
  endsAt      DateTime
  createdAt   DateTime @default(now())

  @@index([endsAt])
}

/// One row per user per quest, written when the quest pays out. The unique
/// (userId, questId) pair makes completion single shot even when submissions
/// race each other.
model QuestCompletion {
  id          String   @id @default(cuid())
  userId      String
  questId     String
  gemsAwarded Int
  createdAt   DateTime @default(now())

  @@unique([userId, questId])
  @@index([userId])
}

/// A model generated payload waiting for owner review. kind is one of quiz,
/// key_notes, quest or notification. The payload is parsed against the same
/// zod schema the matching admin route uses before this row is written, so an
/// approved draft cannot fail at apply time for shape reasons. sourceId is the
/// Mongo document id, or the quest id for a quest notification, and doubles as
/// the dedupe key the nightly notification job checks against.
model AiDraft {
  id         String    @id @default(cuid())
  kind       String
  status     String    @default("pending")
  sourceId   String?
  payload    Json
  model      String
  createdBy  String
  reviewedBy String?
  reviewedAt DateTime?
  /// Id of the thing created when the draft was approved: a document, a quest
  /// or a notification audit row.
  appliedId  String?
  /// Why the last apply attempt failed. A failed apply leaves the row pending
  /// so it can be retried rather than lost.
  error      String?
  createdAt  DateTime  @default(now())

  @@index([status, kind])
  @@index([sourceId, kind])
  @@index([createdAt])
}

/// One embedded passage of the support knowledge base. source is support-md for
/// the curated file, registry for the levels, badges and topics rendered out of
/// code, and content for a Mongo document.
///
/// The embedding column is a pgvector type Prisma cannot express, so it is
/// declared Unsupported and every read and write of this model goes through
/// raw SQL in kb.service.ts. The dimension is fixed by the migration and has to
/// match AI_EMBED_DIM: changing the embedding model is a migration, not an env
/// edit.
model KbChunk {
  id        String                     @id @default(cuid())
  source    String
  sourceId  String?
  heading   String?
  text      String                     @db.Text
  embedding Unsupported("vector(2048)")
  updatedAt DateTime                   @updatedAt

  @@index([source, sourceId])
}
