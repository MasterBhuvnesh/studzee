# Server Configuration
PORT=4000
NODE_ENV=development

# CLerk (Demo) Configuration
CLERK_SECRET_KEY=sk_test_1234567890
CLERK_PUBLISHABLE_KEY=pk_test_1234567890
CLERK_WEBHOOK_SIGNING_SECRET=whsec_1234567890

# MongoDB Configuration
MONGO_PORT=27017
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=password
MONGO_URI=mongodb://root:password@localhost:27017/contentdb
MONGO_EXPRESS_PORT=8081

# MongoDB Express Configuration
ME_CONFIG_BASICAUTH_USERNAME: minioadmin
ME_CONFIG_BASICAUTH_PASSWORD: miniopassword

# Postgres Configuration (users, push tokens, notification and email logs)
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=studzee_notifications
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/studzee_notifications

# Redis Configuration
REDIS_PORT=6379
REDIS_INSIGHT_PORT=8001
REDIS_URL=redis://localhost:6379
REDIS_INSIGHT_URL=http://localhost:8001

# Cache TTL Configuration (in seconds)
LIST_CACHE_TTL=300
DOC_CACHE_TTL=86400
TODAY_CACHE_TTL=3600

# Logging and Authentication
LOG_LEVEL=info
DEV_TOKEN=token

# MinIO Storage Configuration
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=miniopassword
MINIO_BUCKET_NAME=studzee-assets
MINIO_REGION=us-east-1
MINIO_ENDPOINT=http://localhost:9000
MINIO_CONSOLE_ENDPOINT=http://localhost:9001

# AWS SDK Compatibility (Mapping to MinIO)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=miniopassword
AWS_S3_BUCKET_NAME=studzee-assets
AWS_S3_BUCKET_ENDPOINT=http://localhost:9000

# Email Configuration
# Points at the Mailpit container. Every message is caught and shown at
# http://localhost:8025 rather than delivered.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=dev
SMTP_PASSWORD=dev
EMAIL_FROM=Studzee <no-reply@studzee.local>
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Email template values and the attachment host allowlist
SITE_URL=https://studzee.in
EMAIL_BANNER_URL=https://studzee-assets.s3.ap-south-1.amazonaws.com/assets/studzee_banner.png
EMAIL_ATTACHMENT_HOSTS=studzee-assets.s3.ap-south-1.amazonaws.com,localhost
