# =============================================================================
#  STUDZEE BACKEND - DOCKER ENVIRONMENT
# =============================================================================
#  Everything points at the local docker-compose stack, with MinIO standing in
#  for S3 and Mailpit standing in for a mail provider. No cloud account is
#  needed to run the service with this file.
#
#      make env-up      # docker compose --env-file .env.docker up -d
#      npm run dev
#
#  Every credential here is a throwaway local value. Do not reuse any of them
#  anywhere real.
# =============================================================================


# -----------------------------------------------------------------------------
#  SERVER
# -----------------------------------------------------------------------------

PORT=4000
NODE_ENV=development


# -----------------------------------------------------------------------------
#  AUTHENTICATION (CLERK)
# -----------------------------------------------------------------------------
#  Placeholders. Clerk calls fail with these, so use DEV_TOKEN to authenticate
#  locally, or paste real test keys from the Clerk dashboard.

CLERK_SECRET_KEY=sk_test_1234567890
CLERK_PUBLISHABLE_KEY=pk_test_1234567890
CLERK_WEBHOOK_SIGNING_SECRET=whsec_1234567890

# Bearer token that skips Clerk and grants admin. Development only.
DEV_TOKEN=token


# -----------------------------------------------------------------------------
#  MONGODB  (content)
# -----------------------------------------------------------------------------

MONGO_PORT=27017
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=password
MONGO_URI=mongodb://root:password@localhost:27017/contentdb?authSource=admin
MONGO_EXPRESS_PORT=8081

# Mongo Express basic auth, reachable at http://localhost:8081
ME_CONFIG_BASICAUTH_USERNAME=root
ME_CONFIG_BASICAUTH_PASSWORD=password


# -----------------------------------------------------------------------------
#  POSTGRES  (users, push tokens, notification and email logs)
# -----------------------------------------------------------------------------

POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=studzee_notifications
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/studzee_notifications


# -----------------------------------------------------------------------------
#  REDIS  (read cache)
# -----------------------------------------------------------------------------

REDIS_PORT=6379
REDIS_INSIGHT_PORT=8001
REDIS_URL=redis://localhost:6379

# RedisInsight dashboard, reachable at http://localhost:8001
REDIS_INSIGHT_URL=http://localhost:8001


# -----------------------------------------------------------------------------
#  CACHING AND JOBS
# -----------------------------------------------------------------------------

LIST_CACHE_TTL=300
DOC_CACHE_TTL=86400
TODAY_CACHE_TTL=3600


# -----------------------------------------------------------------------------
#  OBJECT STORAGE (MINIO STANDING IN FOR S3)
# -----------------------------------------------------------------------------
#  The minio-init container creates the images, pdfs and assets buckets and
#  marks them publicly readable on startup, so there is nothing to do by hand.

MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=miniopassword
MINIO_BUCKET_NAMES=images,pdfs
MINIO_REGION=us-east-1
MINIO_ENDPOINT=http://localhost:9000
MINIO_CONSOLE_ENDPOINT=http://localhost:9001

# The S3 client reads these. Pointing the endpoint at MinIO is what makes it
# talk to the container instead of Supabase.
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=miniopassword
S3_BUCKET_IMAGES=images
S3_BUCKET_PDFS=pdfs
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000


# -----------------------------------------------------------------------------
#  EMAIL (MAILPIT STANDING IN FOR AN SMTP PROVIDER)
# -----------------------------------------------------------------------------
#  Mailpit catches every message and shows it at http://localhost:8025 rather
#  than delivering it, so nothing reaches a real inbox. It accepts any
#  credentials, so the user and password below are arbitrary.

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=dev
SMTP_PASSWORD=dev
EMAIL_FROM=Studzee <no-reply@studzee.local>
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Localhost is allowlisted so a PDF served by MinIO can be attached in testing.
EMAIL_ATTACHMENT_HOSTS=lammfakgegmrkxdkwukd.supabase.co,localhost


# -----------------------------------------------------------------------------
#  OBSERVABILITY
# -----------------------------------------------------------------------------

LOG_LEVEL=info
