# Server Configuration
PORT=4000
NODE_ENV=development

# Clerk (get these from the Clerk dashboard)
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
# Signing secret for the /webhooks/clerk endpoint. Without it the webhook is
# rejected, since the signature is its only authentication.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# MongoDB, holds content
MONGO_URI=mongodb://mongo:27017/Studzee_Database
DB_NAME=Studzee_Database
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=password

# Postgres, holds users, push tokens, and the notification and email logs
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/studzee_notifications
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=studzee_notifications

# Redis, read cache
REDIS_URL=redis://redis:6379

# Cache TTLs, in seconds
LIST_CACHE_TTL=300
DOC_CACHE_TTL=86400
TODAY_CACHE_TTL=3600

# Scheduler
JOB_CRON='0 0 * * *'

# Logging
LOG_LEVEL=info

# Development authentication bypass. Only honoured when NODE_ENV=development.
# Leave unset in every deployed environment.
DEV_TOKEN=your-dev-token-here

# AWS S3, stores images and PDFs
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET_NAME=your_aws_s3_bucket_name
# Only used in development, for a MinIO endpoint
AWS_S3_BUCKET_ENDPOINT=

# Outbound email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM=Studzee <no-reply@studzee.in>

# Email template values, so copy changes do not need a code deploy
SITE_URL=https://studzee.in
EMAIL_BANNER_URL=https://studzee-assets.s3.ap-south-1.amazonaws.com/assets/studzee_banner.png
# Comma separated hosts an email attachment may be fetched from
EMAIL_ATTACHMENT_HOSTS=studzee-assets.s3.ap-south-1.amazonaws.com

# Keepalive ping for hosts that idle out an instance. Optional.
HEALTHCHECK_URL=
