# =============================================================================
#  STUDZEE BACKEND - ENVIRONMENT TEMPLATE
# =============================================================================
#  Copy this file to .env and fill in the blanks:
#
#      cp .env.example .env
#
#  Loaded by src/config/index.ts and validated with Zod at import time, so a
#  missing or malformed [required] value stops the server at boot rather than
#  failing on the first request that needs it.
#
#  The defaults below target the local stack in docker-compose.yml, so the only
#  values you must supply yourself are the Clerk keys and the AWS credentials.
#  Start the backing services first with:  make up   (or docker-compose up -d)
# =============================================================================


# -----------------------------------------------------------------------------
#  SERVER
# -----------------------------------------------------------------------------

# Port the API listens on.                                          [optional]
PORT=4000

# development | production | test.                                  [required]
# development is the only mode where DEV_TOKEN is honoured.
NODE_ENV=development


# -----------------------------------------------------------------------------
#  AUTHENTICATION (CLERK)
# -----------------------------------------------------------------------------

# From the API Keys page of the Clerk dashboard.                    [required]
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Signing secret of the Clerk webhook pointing at /webhooks/clerk.  [optional]
# Optional to the schema but not to the endpoint: while this is unset every
# delivery is refused with a 500, because the svix signature is that route's
# only authentication. It drives the welcome email on user.created.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# Development only auth bypass.                                     [optional]
# Send it as "Authorization: Bearer <value>" to skip Clerk and act as an admin.
# Honoured only while NODE_ENV=development. Never set this in a deployed
# environment, it is a full authentication bypass.
DEV_TOKEN=local-dev-token


# -----------------------------------------------------------------------------
#  MONGODB  (content)
# -----------------------------------------------------------------------------

# Connection string.                                                [required]
# Local container:  mongodb://root:password@localhost:27017/Studzee_Database?authSource=admin
# Atlas:            mongodb+srv://user:password@cluster.mongodb.net/studzee
MONGO_URI=mongodb://root:password@localhost:27017/Studzee_Database?authSource=admin

# Database name, overrides whatever the URI carries.                [optional]
DB_NAME=Studzee_Database

# Used by the test suite instead of MONGO_URI.                      [optional]
MONGO_URI_TEST=mongodb://root:password@localhost:27017/Studzee_Database_Test?authSource=admin


# -----------------------------------------------------------------------------
#  POSTGRES  (users, push tokens, notification and email logs)
# -----------------------------------------------------------------------------

# Connection string used by Prisma.                                 [required]
# Apply the schema with:  npm run prisma:migrate
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/studzee_notifications

# Consumed by docker-compose.yml when it creates the container.    [docker only]
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=studzee_notifications


# -----------------------------------------------------------------------------
#  REDIS  (read cache)
# -----------------------------------------------------------------------------

# Connection URL. Use rediss:// for a TLS provider such as Upstash. [required]
REDIS_URL=redis://localhost:6379

# Used by the test suite instead of REDIS_URL.                      [optional]
REDIS_URL_TEST=redis://localhost:6379/1


# -----------------------------------------------------------------------------
#  CACHING AND JOBS
# -----------------------------------------------------------------------------

# Cache lifetimes in seconds.                                       [optional]
LIST_CACHE_TTL=300
DOC_CACHE_TTL=86400
TODAY_CACHE_TTL=3600

# Cache refresh schedule.                                           [optional]
# Currently unused: the schedule is hardcoded in jobs/cache-refresh.ts.
JOB_CRON='0 0 * * *'


# -----------------------------------------------------------------------------
#  OBJECT STORAGE (SUPABASE STORAGE, S3 PROTOCOL)
# -----------------------------------------------------------------------------
#  Supabase Storage speaks the S3 protocol, so the AWS SDK talks to it directly.
#  MinIO is used locally and speaks the same protocol, so only the endpoint and
#  credentials differ between environments.
#
#  The defaults below point at the local MinIO container. For Supabase, take the
#  values from Project Settings > Storage > S3 Connection in the dashboard.

# Project region. Must match exactly or every request fails signing. [required]
S3_REGION=ap-northeast-2

# S3 access keys.                                                    [required]
# Supabase: generate under Project Settings > Storage > S3 access keys.
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=miniopassword

# Bucket that holds uploaded images and PDFs.                        [required]
# Not the assets bucket, which only serves the brand banner.
S3_BUCKET=studzee

# S3 API endpoint.                                                   [required]
# MinIO:    http://localhost:9000
# Supabase: https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_ENDPOINT=http://localhost:9000

# Base that public object URLs are built from, with the key appended. [required]
# Supabase serves public objects from a different host to its S3 endpoint, so
# this cannot be derived from S3_ENDPOINT.
# MinIO:    http://localhost:9000/<bucket>
# Supabase: https://<project-ref>.supabase.co/storage/v1/object/public/<bucket>
S3_PUBLIC_URL=http://localhost:9000/studzee


# -----------------------------------------------------------------------------
#  EMAIL
# -----------------------------------------------------------------------------

# SMTP transport.                                                   [required]
# These defaults point at the Mailpit container, which catches every message
# and shows it at http://localhost:8025 instead of delivering it. Mailpit
# accepts any credentials. Port 465 uses implicit TLS, anything else STARTTLS.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=dev
SMTP_PASSWORD=dev
EMAIL_FROM=Studzee <no-reply@studzee.local>

# Values interpolated into the email templates.                     [optional]
# Kept as config so copy changes do not need a code deploy.
SITE_URL=https://studzee.in
EMAIL_BANNER_URL=https://lammfakgegmrkxdkwukd.supabase.co/storage/v1/object/public/assets/studzee_banner.png

# Hosts an email attachment may be fetched from, comma separated.   [optional]
# The mail transport fetches attachments by URL at send time, so anything not
# on this list is rejected before the message goes out. Add localhost while
# attachments are served from MinIO.
EMAIL_ATTACHMENT_HOSTS=lammfakgegmrkxdkwukd.supabase.co,localhost

# Mailpit host ports.                                              [docker only]
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025


# -----------------------------------------------------------------------------
#  OBSERVABILITY
# -----------------------------------------------------------------------------

# fatal | error | warn | info | debug | trace | silent.             [optional]
LOG_LEVEL=info

# Keepalive target for hosts that idle an instance out, such as     [optional]
# Render free tier. The job pings it every 14 minutes and is skipped entirely
# while this is empty, or when NODE_ENV=test.
HEALTHCHECK_URL=


# -----------------------------------------------------------------------------
#  OPTIONAL DOCKER PORT OVERRIDES
# -----------------------------------------------------------------------------
#  Uncomment only to move a container off its default host port.
#
#  MONGO_PORT=27017
#  MONGO_ROOT_USER=root
#  MONGO_ROOT_PASSWORD=password
#  MONGO_EXPRESS_PORT=8081
#  REDIS_PORT=6379
#  REDIS_INSIGHT_PORT=8001
#  MINIO_PORT=9000
#  MINIO_CONSOLE_PORT=9001
#  MINIO_ROOT_USER=minioadmin
#  MINIO_ROOT_PASSWORD=miniopassword
