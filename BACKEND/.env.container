# =============================================================================
#  STUDZEE BACKEND - CONTAINER ENVIRONMENT
# =============================================================================
#  For running the API itself inside a container, against the docker-compose
#  stack. Every dependency is addressed by its compose service name, because
#  inside a container "localhost" is the container, not the host.
#
#      docker build -t studzee-api:local .
#      docker compose up -d
#      docker run --rm --name studzee_api \
#        --network studzee_network \
#        --env-file .env.container \
#        -p 4000:3000 \
#        studzee-api:local
#
#  Do not confuse this with .env.docker. That file addresses the same stack as
#  "localhost" because it is read by a process running on the host, either
#  docker compose itself or "npm run dev". The two files are not
#  interchangeable, and using the wrong one fails at boot with P1001 from
#  Prisma before the application starts.
#
#  This file holds only the variables the application parses. Compose reads its
#  own settings from .env.docker, so nothing here is used for substitution.
#
#  Every credential here is a throwaway local value. Do not reuse any of them
#  anywhere real.
# =============================================================================


# -----------------------------------------------------------------------------
#  SERVER
# -----------------------------------------------------------------------------
#  3000, not 4000. The Dockerfile declares EXPOSE 3000 and its HEALTHCHECK
#  probes port 3000, so the application has to listen there for the container
#  to ever report healthy. Publish it on whatever host port you like:
#  -p 4000:3000 keeps the usual http://localhost:4000 from outside.

PORT=3000
NODE_ENV=development


# -----------------------------------------------------------------------------
#  AUTHENTICATION (CLERK)
# -----------------------------------------------------------------------------
#  Placeholders. Clerk calls fail with these, so use DEV_TOKEN to authenticate
#  locally, or paste real test keys from the Clerk dashboard.

CLERK_SECRET_KEY=sk_test_1234567890
CLERK_PUBLISHABLE_KEY=pk_test_1234567890
CLERK_WEBHOOK_SIGNING_SECRET=whsec_1234567890

# Bearer token that skips Clerk and grants admin. Development only.
DEV_TOKEN=token


# -----------------------------------------------------------------------------
#  MONGODB  (content)
# -----------------------------------------------------------------------------
#  Host is the compose service name "mongo", not localhost.

MONGO_URI=mongodb://root:password@mongo:27017/contentdb?authSource=admin


# -----------------------------------------------------------------------------
#  POSTGRES  (users, push tokens, notification and email logs)
# -----------------------------------------------------------------------------
#  Host is the compose service name "postgres". The container runs
#  "prisma migrate deploy" before starting, so this is the first thing that
#  fails if the hostname is wrong.

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/studzee_notifications


# -----------------------------------------------------------------------------
#  REDIS  (read cache)
# -----------------------------------------------------------------------------

REDIS_URL=redis://redis:6379


# -----------------------------------------------------------------------------
#  CACHING AND JOBS
# -----------------------------------------------------------------------------

LIST_CACHE_TTL=300
DOC_CACHE_TTL=86400
TODAY_CACHE_TTL=3600


# -----------------------------------------------------------------------------
#  OBJECT STORAGE (MINIO STANDING IN FOR S3)
# -----------------------------------------------------------------------------
#  The two URLs deliberately differ, which mirrors Supabase, where the S3
#  endpoint and the public URL are also different hosts.
#
#  S3_ENDPOINT is where this container uploads to, so it uses the service name.
#  S3_PUBLIC_URL is written onto the document and fetched later by a browser or
#  a mobile client on the host, so it has to stay localhost. A client outside
#  Docker cannot resolve "minio".

S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=miniopassword
S3_BUCKET_IMAGES=images
S3_BUCKET_PDFS=pdfs
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_URL=http://localhost:9000


# -----------------------------------------------------------------------------
#  EMAIL (MAILPIT STANDING IN FOR AN SMTP PROVIDER)
# -----------------------------------------------------------------------------
#  Host is the compose service name "mailpit". Read what was sent at
#  http://localhost:8025 from the host.

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=dev
SMTP_PASSWORD=dev
EMAIL_FROM=Studzee <no-reply@studzee.local>

#  Attachments are fetched by this container at send time, so the host has to be
#  one this container can resolve. "minio" is listed for that reason.
#
#  Note the limitation: PDF URLs stored on a document use S3_PUBLIC_URL, so they
#  read http://localhost:9000/... and this container cannot fetch them, which
#  makes pdfUrls on /admin/emails/send fail from inside Docker. Everything else
#  about email works. Sending without attachments is unaffected.
EMAIL_ATTACHMENT_HOSTS=lammfakgegmrkxdkwukd.supabase.co,localhost,minio


# -----------------------------------------------------------------------------
#  OBSERVABILITY
# -----------------------------------------------------------------------------

LOG_LEVEL=info
